{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "context": {
      "()": "multimodal_vision_pipeline.observability.logging.ContextFilter"
    }
  },
  "formatters": {
    "json": {
      "()": "multimodal_vision_pipeline.observability.logging.JsonFormatter"
    }
  },
  "handlers": {
    "mvp-json": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr",
      "formatter": "json",
      "filters": ["context"]
    }
  },
  "loggers": {
    "uvicorn": {"level": "INFO", "handlers": [], "propagate": true},
    "uvicorn.error": {"level": "INFO", "handlers": [], "propagate": true},
    "uvicorn.access": {"level": "WARNING", "handlers": [], "propagate": true}
  },
  "root": {"level": "INFO", "handlers": ["mvp-json"]}
}
